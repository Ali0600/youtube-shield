{
  "manifest_version": 3,
  "name": "YouTube Shield",
  "version": "0.1.0",
  "description": "Skips YouTube ads the moment they start and hides display ads, without blocking any YouTube request.",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "background": { "service_worker": "src/background.js" },
  "action": {
    "default_title": "YouTube Shield",
    "default_popup": "src/popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*", "*://*.youtube-nocookie.com/*"],
      "js": ["src/page.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["*://*.youtube.com/*", "*://*.youtube-nocookie.com/*"],
      "js": ["src/bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
